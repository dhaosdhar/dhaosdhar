#!/bin/bash
# postrm dhaos : l'environnement Python est généré à l'installation, on le retire.
set -e
case "$1" in
  remove|purge)
    rm -rf /opt/dhaos/venv
    if [ "$1" = "purge" ]; then rm -rf /opt/dhaos; fi
    if command -v systemctl >/dev/null 2>&1; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
    ;;
esac
exit 0
